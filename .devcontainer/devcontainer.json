{
  "name": "GitHub Actions",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CONTAINER_USER": "mono",
      "CONTAINER_GROUP": "mono"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github"
      ]
    }
  },
  "remoteUser": "mono"
}
